JWT_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_MB=50
RATE_LIMIT_MAX=300
CLIENT_ORIGIN=http://localhost:4000
# SNMP supervision. Keep false for production until devices are configured.
SNMP_DEMO_MODE=true
SNMP_POLL_INTERVAL_MS=60000
# JSON array. Example:
# SNMP_DEVICES=[{"name":"SW-01","host":"192.168.1.10","community":"public","version":"2c","timeout":1500,"retries":1}]
SNMP_DEVICES=[]
# Optional UDP trap receiver for a network deployment (not normally available on Render Web Services).
# SNMP_TRAP_PORT=10162
